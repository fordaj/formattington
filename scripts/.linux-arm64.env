# Platform env for linux-arm64.
# Sourced by scripts/env.sh after .common.env.
# VERSIONER_BIN is resolved by env.sh to the newest
# tools/versioner/v*/linux-arm64/versioner (fallback: versioner on PATH).
# LOGAMUFFIN_BIN is resolved by env.sh to the newest
# tools/logamuffin/v*/linux-arm64/logamuffin (fallback: logamuffin on PATH).
# RUNNER_SPAWNER_BIN is resolved by env.sh to the newest
# tools/runner-spawner/v*/linux-arm64/runner-spawner (fallback: runner-spawner
# on PATH). runner-spawner reports unsupported on Linux (macOS + Windows only);
# the binary is still shipped for uniform bundle layout.
# SEVENZZ_BIN points to the 7zz binary for Linux arm64.

PROJECT_PLATFORM="linux-arm64"

VERSIONER_BIN="${VERSIONER_VERSION_DIR}/${PROJECT_PLATFORM}/versioner"
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner"
SEVENZZ_BIN="${SEVENZIP_VERSION_DIR}/linux-arm64/7zz"
