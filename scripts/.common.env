# scripts/.common.env — base environment for MirrorClone.
# 
# Sourced by scripts/env.sh before the platform-specific env
# (.<platform>.env, e.g. .macos-x86_64.env). Platform-independent
# variables live here; OS/arch specifics live there.
#
# The platform specific env files also set PROJECT_PLATFORM (e.g.
# "macos-x86_64"), the name of the platform of the current machine. It is
# used to resolve the bundled tools and the built binaries
# (dist/<platform>/mirror-clone).

TOOLS_DIR="tools"

VERSIONER_REPO="fordaj/Versioner"
VERSIONER_TAG_PATTERN="v[0-9]*"
VERSIONER_CONFIG_FILE=".versioner.json"
VERSIONER_DIR="${TOOLS_DIR}/versioner"
VERSIONER_VERSION_DIR="${VERSIONER_DIR}/v0.0.3.0.5"

LOGAMUFFIN_REPO="fordaj/logamuffin"
LOGAMUFFIN_DIR="${TOOLS_DIR}/logamuffin"
LOGAMUFFIN_VERSION_DIR="${LOGAMUFFIN_DIR}/v0.1.3.0.35"

RUNNER_SPAWNER_TOOL_REPO="fordaj/runner-spawner"
RUNNER_SPAWNER_DIR="${TOOLS_DIR}/runner-spawner"
RUNNER_SPAWNER_VERSION_DIR="${RUNNER_SPAWNER_DIR}/v0.0.1.1.6"

SEVENZIP_DIR="${TOOLS_DIR}/7zip"
SEVENZIP_VERSION_DIR="${SEVENZIP_DIR}/v26.06"
