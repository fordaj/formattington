# Platform env for windows-arm64.
# Sourced by scripts/env.sh after .common.env.
# The versioner bundle has no windows-arm64 build (upstream ships
# windows-amd64 only); env.sh falls back to versioner on PATH.
# The logamuffin and runner-spawner bundles do ship windows-arm64
# (tools/logamuffin/v*/windows-arm64/logamuffin.exe and
# tools/runner-spawner/v*/windows-arm64/runner-spawner.exe;
# fallback: logamuffin / runner-spawner on PATH).
# SEVENZZ_BIN points to the 7zr.exe binary for Windows (7z format only).

PROJECT_PLATFORM="windows-arm64"

VERSIONER_BIN="${VERSIONER_VERSION_DIR}/${PROJECT_PLATFORM}/versioner.exe"
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin.exe"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner.exe"
SEVENZZ_BIN="${SEVENZIP_VERSION_DIR}/windows/7zr.exe"
